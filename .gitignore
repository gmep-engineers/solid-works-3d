# Dependencies
node_modules/
*/node_modules/
supplier-windows-app/*/node_modules/

# Build outputs
web/.next/
web/out/
backend/dist/
supplier-windows-app/*/dist/
supplier-windows-app/*/publish/
supplier-windows-app/*/bin/
