<Window x:Class="Levitate3D.Supplier.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Levitate3D — Supplier Manufacturing Terminal (Hardware Bound)" 
        Height="760" Width="1200"
        Background="{StaticResource BackgroundDark}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#11141E" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="LEVITATE3D // SUPPLIER DESKTOP GATEWAY" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                    <Border Background="#10B981" CornerRadius="4" Padding="6,2" Margin="12,0,0,0">
                        <TextBlock Text="mTLS Bound" Foreground="Black" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#F59E0B" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                        <TextBlock Text="WORM Audit Guard" Foreground="Black" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatus" Text="Connected to /api/v1/supplier/*" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button x:Name="BtnRefresh" Content="Refresh Queue" Padding="10,4" Background="#1E2436" Foreground="White" BorderBrush="#2F3854" Click="BtnRefresh_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Workspace (3 Columns) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: Job Queues -->
            <Border Grid.Column="0" Background="#0F121B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock Text="Assigned Jobs Queue" DockPanel.Dock="Top" Foreground="#00F0FF" FontSize="12" FontWeight="Bold" Margin="12,12,12,8" />
                    <ListBox x:Name="ListJobs" Background="Transparent" BorderThickness="0" SelectionChanged="ListJobs_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151926" BorderBrush="#21283C" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding JobCode}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" />
                                        <TextBlock Text="{Binding HardwareSpecs.Size}" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding SupplierStage}" Foreground="#00F0FF" FontSize="10" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Column 2: Job Details & Hardware Specs -->
            <ScrollViewer Grid.Column="1" Padding="20">
                <StackPanel x:Name="PanelJobDetails">
                    <TextBlock x:Name="TxtJobCode" Text="JOB-LEV-2026-891042" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="TxtJobSpecsSummary" Text="Large 180mm x 110mm • Translucent Glow Resin" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,16" />

                    <!-- Spec Cards -->
                    <Border Background="#141722" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="MAGNETIC BASE CAVITY SPECIFICATION" Foreground="#00F0FF" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="TxtMagnetCavity" Text="18.2mm diameter x 6.5mm depth cylindrical cavity centered at statue base (N52 Magnet Socket)" Foreground="#E2E8F0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#141722" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="INTERNAL WIRELESS LED SPECIFICATION" Foreground="#A855F7" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="TxtLedSpecs" Text="3.0mm smooth curved conduit + hollow core (2.0mm wall) for inductive wireless coil." Foreground="#E2E8F0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="#141722" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="DESIGNER ADJUSTMENT NOTES" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" />
                            <TextBlock x:Name="TxtNotes" Text="Smooth facial details and hollow chest cavity for inductive wireless LED receiver." Foreground="#E2E8F0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Column 3: Actions & Production Updater -->
            <Border Grid.Column="2" Background="#0D1017" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1,0,0,0" Padding="16">
                <StackPanel>
                    <TextBlock Text="Production Actions" Foreground="White" FontSize="13" FontWeight="Bold" Margin="0,0,0,12" />

                    <!-- Upload Calibrated 3D Model -->
                    <Border Background="#131722" BorderBrush="#1E2538" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Upload Calibrated .STL/.GLB" Foreground="White" FontSize="11" FontWeight="Bold" />
                            <TextBox x:Name="TxtModelUrl" Text="https://storage.levitate3d.io/vault/refined_model.glb" Background="#090A0F" Foreground="White" BorderBrush="#282F44" Padding="6" Margin="0,8,0,0" />
                            <TextBox x:Name="TxtUploadNotes" Text="Calibrated for levitation equilibrium. Added magnet socket." Background="#090A0F" Foreground="White" BorderBrush="#282F44" Padding="6" Margin="0,6,0,0" Height="40" TextWrapping="Wrap" />
                            <Button Content="Upload to WORM Ledger" Background="#00F0FF" Foreground="Black" FontWeight="Bold" Margin="0,8,0,0" Padding="8,6" Click="BtnUpload_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Advance Production Stage -->
                    <Border Background="#131722" BorderBrush="#1E2538" BorderThickness="1" CornerRadius="10" Padding="12">
                        <StackPanel>
                            <TextBlock Text="Progress Stage" Foreground="White" FontSize="11" FontWeight="Bold" />
                            <Button Content="Advance to Printing &amp; LED Assembly" Background="#1E2436" Foreground="White" BorderBrush="#2F3854" Margin="0,8,0,0" Padding="8,6" Click="BtnAdvancePrinting_Click" />
                            <TextBox x:Name="TxtTracking" Text="DHL-9847291048" Background="#090A0F" Foreground="White" BorderBrush="#282F44" Padding="6" Margin="0,8,0,0" />
                            <Button Content="Mark Packaged &amp; Shipped" Background="#10B981" Foreground="Black" FontWeight="Bold" Margin="0,8,0,0" Padding="8,6" Click="BtnShip_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
