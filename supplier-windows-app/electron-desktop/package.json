{
  "name": "levitate3d-supplier-desktop",
  "version": "1.0.0",
  "description": "Strictly Isolated Windows Desktop Fulfillment Client for 3D Designers & Print Operators",
  "main": "src/main.js",
  "author": "Antigravity Engineering",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win --dir",
    "build:installer": "electron-builder --win --x64"
  },
  "dependencies": {
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.levitate3d.supplier",
    "productName": "Levitate3D Vendor Terminal",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
