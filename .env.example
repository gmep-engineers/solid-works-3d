# ==============================================================================
# LEVITATE3D PLATFORM CONFIGURATION
# Custom Magnetic Levitating & Illuminated 3D Statue Platform
# ==============================================================================

# Server Environment
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/levitate3d
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=levitate3d

# JWT Stateless Authentication (Headless API for iOS, Android & Desktop)
JWT_SECRET=levitate-super-secret-worm-jwt-key-2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=levitate-super-refresh-key-2026

# Tripo3D API Integration (Text-to-3D, Image-to-3D, Sketch-to-3D)
# Sign up at https://platform.tripo3d.ai to acquire an API key.
# When left empty or TRIPO3D_MOCK_MODE=true, realistic fast 3D simulation mode is enabled.
TRIPO3D_API_KEY=
TRIPO3D_API_URL=https://api.tripo3d.ai/v2/openapi
TRIPO3D_MOCK_MODE=true

# Stripe Payments & Webhooks
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_stripe_secret
STRIPE_MOCK_MODE=true

# S3 / MinIO Object Lock Storage Vault (Immutable retention for .glb, .stl, & receipts)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=levitate3d-vault
S3_REGION=us-east-1
S3_OBJECT_LOCK_ENABLED=true
LOCAL_STORAGE_PATH=./uploads

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
